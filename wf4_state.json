        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "680b92ec-42be-4491-93a1-3fc723e348d7",
              "leftValue": "={{ $json.balance_after }}",
              "rightValue": 200000,
