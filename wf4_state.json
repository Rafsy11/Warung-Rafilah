      "position": [
        1560,
        540
      ]
    },
    {
      "parameters": {
        "jsCode": "const balance = Number($input.first().json.balance_after) || 0;\nconst fmt = (n) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(n);\n\nconst whatsapp_text = `⚠️ *Peringatan Saldo Float Rendah* ⚠️\\n\\n` +\n    `Saldo float agen saat ini: *${fmt(balance)}*\\n` +\n    `🔔 Batas minimal adalah *Rp200.000*.\\n` +\n    `Silakan lakukan top-up saldo sebelum ada transaksi penarikan besar berikutnya.`;\n    \nreturn [{ json: { whatsapp_text } }];"
      },
      "id": "8b09c452-1e97-4c9c-a0e5-2682a12b6951",
      "name": "Format Alert Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        510
      ]
    },
    {
      "id": "d956a5d1-fac0-4c02-b452-efba65a9118e",
      "name": "Send WhatsApp Alert",
