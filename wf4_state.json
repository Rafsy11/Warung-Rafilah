      "typeVersion": 202502,
      "position": [
        2000,
        510
      ],
      "parameters": {
        "resource": "Chatting",
        "operation": "Send Text",
        "session": "default",
        "chatId": "120363226138191044@g.us",
        "text": "={{ $json.whatsapp_text }}"
      },
      "credentials": {
        "wahaApi": {
          "id": "uXjZvjc5y9NnRc37",
          "name": "WAHA account"
        }
      }
    }
