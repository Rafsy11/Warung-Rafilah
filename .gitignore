# ── Windows-only scripts (tidak dibutuhkan di PC Kasir Linux) ──
*.bat
start-pos.ps1

# ── File workflow state internal (hanya untuk development) ──
wf*.json

# ── n8n data folder (berisi credentials & runtime data, jangan di-git) ──
n8n_data/

# ── UI prototype (bukan bagian deployment) ──
ui.html

# ── OS artifacts ──
.DS_Store
Thumbs.db

# ── VS Code settings (opsional, boleh hapus jika ingin share settings) ──
.vscode/

# Environment secrets
.env
.env.*
!.env.example

# Database backups & dumps
backups/
*.sql
!app/migrations/*.sql
!db/init/*.sql
*.sql.gz
*.dump

# Log files
logs/
*.log
ssl/*.pem
app/lint-results.json
app/test-results/

