                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\n\nlet message = \u0027🤖 *Bot Warung Menjawab*\\n\\n\u0027;\n\nif (items.length === 0 || (items.length === 1 \u0026\u0026 !items[0].json.barcode)) {\n  message += \u0027✅ Semua stok produk dalam keadaan aman! Tidak ada yang menipis.\\n\u0027;\n} else {\n  message += \u0027Berikut adalah barang yang stoknya 10 atau kurang:\\n\\n\u0027;\n  items.forEach((item, i) =\u003e {\n    const d = item.json;\n    if(d.name) {\n      message += `${i + 1}. *${d.name}* (Sisa: ${d.stock_qty})\\n`;\n    }\n  });\n  message += \u0027\\n🔔 Silakan lakukan restock!\u0027;\n}\n\nreturn [{ json: { whatsapp_text: message } }];"
                                     },
